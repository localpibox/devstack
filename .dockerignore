# Docker build ignore patterns

# Git
.git
.gitignore

# Node
node_modules
package-lock.json
*.tsbuildinfo

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docs (not needed in image)
*.md

# Env files
.env
.env.*
!.env.example

# Biome
biome.base.json

# Local build artifacts
support/node_modules
*.tgz
