# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored — never commit real keys.

# Used by the exa MCP server (see config/mcp-servers.json)
EXA_API_KEY=

# Optional: if you want to keep a placeholder for an overflow provider in
# your own Pi session, set it here. The default local-model path is now
# handled by the Lemonade Pi plugin, not a checked-in models.json file.
OPENROUTER_API_KEY=

# Uncomment if you enable the optional postgres sibling service in docker-compose.yml
# POSTGRES_PASSWORD=

# Agent-browser session — uses PI_WORKTREE_ID for worktree isolation.
# Subagent sessions get unique IDs via session-uuid command.
AGENT_BROWSER_SESSION=${PI_WORKTREE_ID}

# OpenVSCode connection token — change from default for production use.
# WARNING: If EDITOR_HOST=0.0.0.0 (default), the editor is exposed on the LAN.
# Anyone who knows the host IP and port can access your workspace.
CONNECTION_TOKEN=devsession

# --- LocalPibox Repo URLs ---
# These are set in settings.json by the config repo install script
# No need to configure here unless overriding
