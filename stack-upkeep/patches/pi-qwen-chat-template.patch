From e8a7d0a1d5c877ab50e28895420cac094c7f86dd Mon Sep 17 00:00:00 2001
From: localpibox <localpibox@users.noreply.github.com>
Date: Thu, 30 Jul 2026 08:09:55 +0000
Subject: [PATCH] fix(ai): add reasoning_effort for qwen-chat-template thinking
 format

The upstream already has reasoning_effort for the "qwen" format but
was missing it for "qwen-chat-template". This adds it to match the
pattern used for zai, deepseek, together, and other formats.
---
 packages/ai/src/api/openai-completions.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/ai/src/api/openai-completions.ts b/packages/ai/src/api/openai-completions.ts
index 3321c610..dfd163c5 100644
--- a/packages/ai/src/api/openai-completions.ts
+++ b/packages/ai/src/api/openai-completions.ts
@@ -763,6 +763,10 @@ function buildParams(
 			enable_thinking: !!options?.reasoningEffort,
 			preserve_thinking: true,
 		};
+		if (options?.reasoningEffort) {
+			(params as any).chat_template_kwargs.reasoning_effort =
+				model.thinkingLevelMap?.[options.reasoningEffort] ?? options.reasoningEffort;
+		}
 	} else if (compat.thinkingFormat === "chat-template" && model.reasoning) {
 		const chatTemplateKwargs = buildChatTemplateKwargs(model, options, compat);
 		if (chatTemplateKwargs) {
-- 
