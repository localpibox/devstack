# Stack Upkeep — Version Tracking
# 
# This file tracks which commit/branch of each repo is in use.
# Change these values to trigger rebuilds (Docker uses them as ARG cache-busters).
# After updating, run: ./stack-upkeep/scripts/validate-status.sh
#
# Format: repo=branch_or_sha
# - Use a branch name for continuous tracking (e.g., "main")
# - Use a SHA for pinned builds (e.g., "6bcc29a")

# ── Pi Monorepo ──────────────────────────────────────────────────────────────
# Fork: localpibox/pi (patches on top of earendil-works/pi)
# Branch: which branch to build from (use "patches/qwen-reasoning" or a SHA)
# Patches: applied from stack-upkeep/patches/pi-*.patch
pi_branch=patches/qwen-reasoning-effort
pi_fork=https://github.com/localpibox/pi.git
pi_upstream=https://github.com/earendil-works/pi.git

# ── Lemonade Plugin ─────────────────────────────────────────────────────────
# Fork: localpibox/lemonade-pi-plugin (patches on top of lemonade-sdk/lemonade-pi-plugin)
lemonade_branch=patches/qwen-vision
lemonade_fork=https://github.com/localpibox/lemonade-pi-plugin.git
lemonade_upstream=https://github.com/lemonade-sdk/lemonade-pi-plugin.git

# ── Memory Extension ────────────────────────────────────────────────────────
# Branch with subprocess-provider fixes
memory_branch=fix/subprocess-provider
memory_repo=https://github.com/localpibox/pi-hermes-memory.git

# ── Build Configuration ─────────────────────────────────────────────────────
# These are passed as ARG to Docker to control cache invalidation
# Change any value to invalidate that layer of the build
pi_patch_version=20260730-003
lemonade_patch_version=20260730-003
