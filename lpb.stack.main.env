# lpb.stack.main.env — Main profile configuration
#
# Points to stable branches (lpb + main).
# Used when running: lpb --tag main or lpb --tag latest

# ─── Pi Monorepo ────────────────────────────────────────────────────────
# Use 'lpb' branch (stable base) for main pipeline.
LPB_PI_REF=lpb

# ─── Config Preset ───────────────────────────────────────────────────────
LPB_CONFIG_REF=main
