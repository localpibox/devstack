# Stack Upkeep — Version Tracking
#
# This file tracks versions used at Docker build time.
# Dockerfile reads these as ARG cache-busters.
#
# Format: repo=branch_or_sha
# - Use a branch name for continuous tracking (e.g., "main")
# - Use a SHA for pinned builds (e.g., "6bcc29a")
#
# NOTE: Runtime extensions (lemonade-pi-plugin, pi-hermes-memory) are NOT
#       built into the image. They are cloned at container startup by
#       `pi update --extensions`, which reads their branches from
#       .pi/agent/settings.json → "packages" array.

# ── Pi Monorepo ──────────────────────────────────────────────────────────────
# Fork: localpibox/pi (cumulative patches on top of earendel-works/pi)
# Branch: which branch to build from (patches already baked in)
pi_branch=patches/qwen-reasoning-effort
pi_fork=https://github.com/localpibox/pi.git
pi_upstream=https://github.com/earendil-works/pi.git

# ── Base Versions ────────────────────────────────────────────────────────────
# Also update Dockerfile ARG defaults when changing these
node_version=24
vscodium_version=1.126.04524

# ── Qwen3 Thinking Overflow Fix (2026-08-02) ────────────────────────────────
# max_tokens as a fraction of context_window. Reduced from 0.125 to 0.06
# to prevent overflow errors with Qwen thinking models (10-20k thinking blocks).
# 0.06 × 262k = ~15.7k maxTokens — leaves room for thinking within window.
# See: doc/QWEN-THINKING-OVERFLOW.md, doc/implementation-plan.md
max_tokens_context_ratio=0.06
